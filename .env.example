# =========================================================================
# SuperPlane Autopilot - Secure Service Harness Environment Config
# =========================================================================

# Port for the local Express Webhook Ingestion server
PORT=3000

# Google Gemini API Key (For Node 3: AI-Agent log diagnostics)
# Generate a free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...

# Render API Credentials (For Node 2 & 4: Sensor/Action service mutations)
# Generate from Account Settings -> API Tokens in Render Dashboard
RENDER_API_KEY=rnd_...
RENDER_API_ENDPOINT=https://api.render.com/v1/services/srv-web-api

# Discord Operations Notification URL (For Node 5: Alerts)
# Created inside your Discord Server -> Channel Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
